{
  "uid": "exposure",
  "title": "External exposure",
  "tags": [
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 4,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "exposure-pg"
        },
        "query": "SELECT DISTINCT coalesce(provider, '') FROM v_current_endpoints ORDER BY 1",
        "definition": "SELECT DISTINCT coalesce(provider, '') FROM v_current_endpoints ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": "'__all'"
      },
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "exposure-pg"
        },
        "query": "SELECT DISTINCT coalesce(account, '') FROM v_current_endpoints ORDER BY 1",
        "definition": "SELECT DISTINCT coalesce(account, '') FROM v_current_endpoints ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": "'__all'"
      },
      {
        "name": "accepted",
        "label": "Show accepted",
        "type": "custom",
        "query": "hide,show",
        "current": {
          "text": "hide",
          "value": "hide"
        },
        "options": [
          {
            "text": "hide",
            "value": "hide",
            "selected": true
          },
          {
            "text": "show",
            "value": "show",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Public endpoints",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT endpoints AS \"Endpoints\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Change vs last run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT endpoints_delta AS \"\u0394 endpoints\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Progress vs baseline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT progress_pct AS \"Fewer than baseline\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Findings",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT critical AS \"Critical\", high AS \"High\", medium AS \"Medium\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Exploited (KEV)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Exploited\" FROM v_current_findings WHERE exploited AND NOT accepted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Current findings listed in CISA's Known Exploited Vulnerabilities catalog. Fix these first."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Overdue",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Overdue\" FROM v_current_findings WHERE NOT accepted AND ((exploited OR severity IN ('critical', 'high')) AND age_days > 30 OR severity = 'medium' AND age_days > 90)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Open findings past their deadline: exploited, critical and high after 30 days, medium after 90."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last successful run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT finished_at AS time, id AS \"Run\" FROM v_latest_run"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^time$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Public endpoints and findings per run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT finished_at AS time, endpoints AS \"Endpoints\", findings AS \"Findings\", critical + high AS \"Critical + high\"\nFROM v_run_deltas WHERE $__timeFilter(finished_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "pointSize": 6,
            "showPoints": "always",
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Current public endpoints",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT host, port, provider, account, resource, url, http_status AS status, title, array_to_string(tech, ', ') AS tech, age_days AS age\nFROM v_current_endpoints WHERE ('__all' IN (${provider:sqlstring}) OR coalesce(provider, '') IN (${provider:sqlstring})) AND ('__all' IN (${account:sqlstring}) OR coalesce(account, '') IN (${account:sqlstring})) ORDER BY host, port"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Current findings",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN exploited THEN 'exploited' ELSE '' END AS kev, severity, nullif(epss, 0) AS epss,\n       template_id, name, matched_at, age_days AS age, account, resource,\n       array_to_string(tags, ', ') AS tags, scanner, accepted_reason AS accepted,\n       CASE WHEN template_id ILIKE 'CVE-%' THEN 'https://nvd.nist.gov/vuln/detail/' ELSE 'https://cloud.projectdiscovery.io/library/' END || split_part(template_id, ':', 1) AS link\nFROM v_current_findings WHERE ('__all' IN (${provider:sqlstring}) OR coalesce(provider, '') IN (${provider:sqlstring})) AND ('__all' IN (${account:sqlstring}) OR coalesce(account, '') IN (${account:sqlstring}))\n  AND (NOT accepted OR '${accepted}' = 'show')\nORDER BY exploited DESC, array_position(ARRAY['critical','high','medium','low','info'], severity), epss DESC NULLS LAST, template_id"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "template_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Details",
                    "url": "${__data.fields.link}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              },
              {
                "id": "custom.minWidth",
                "value": 400
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": false,
                  "tooltip": false
                }
              },
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "kev"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "exploited": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "color": "transparent",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "epss"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "description": "Ordered by real-world risk: actively exploited (CISA KEV) first, then severity, then EPSS (probability of exploitation in the next 30 days). Accepted findings are hidden unless 'Show accepted' is on."
    },
    {
      "id": 9,
      "type": "table",
      "title": "Changes (selected time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT finished_at AS time, type, target, port, severity, detail->>'template_id' AS finding,\n       provider, account, resource,\n       CASE WHEN detail->>'template_id' ILIKE 'CVE-%' THEN 'https://nvd.nist.gov/vuln/detail/'\n            WHEN detail->>'template_id' IS NOT NULL THEN 'https://cloud.projectdiscovery.io/library/' END || split_part(detail->>'template_id', ':', 1) AS link\nFROM v_events WHERE $__timeFilter(finished_at) AND ('__all' IN (${provider:sqlstring}) OR coalesce(provider, '') IN (${provider:sqlstring})) AND ('__all' IN (${account:sqlstring}) OR coalesce(account, '') IN (${account:sqlstring})) ORDER BY finished_at DESC, type"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "finding"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Details",
                    "url": "${__data.fields.link}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": false,
                  "tooltip": false
                }
              },
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    }
  ]
}
