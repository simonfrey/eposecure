        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Progress vs baseline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT progress_pct AS \"Fewer than baseline\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
