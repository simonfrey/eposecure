{
  "uid": "exposure",
  "title": "External exposure",
  "tags": [
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 4,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "exposure-pg"
        },
        "query": "SELECT DISTINCT coalesce(provider, '') FROM v_current_endpoints ORDER BY 1",
        "definition": "SELECT DISTINCT coalesce(provider, '') FROM v_current_endpoints ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": "'__all'"
      },
      {
        "name": "account",
        "label": "Account",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "exposure-pg"
        },
        "query": "SELECT DISTINCT coalesce(account, '') FROM v_current_endpoints ORDER BY 1",
        "definition": "SELECT DISTINCT coalesce(account, '') FROM v_current_endpoints ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": "'__all'"
      },
      {
        "name": "accepted",
        "label": "Show accepted",
        "type": "custom",
        "query": "hide,show",
        "current": {
          "text": "hide",
          "value": "hide"
        },
        "options": [
          {
            "text": "hide",
            "value": "hide",
            "selected": true
          },
          {
            "text": "show",
            "value": "show",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "scan_phase",
        "label": "Run phase",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "exposure-pg"
        },
        "query": "SELECT phase FROM v_scan_phases ORDER BY CASE state WHEN 'running' THEN 0 ELSE 1 END, ord",
        "definition": "SELECT phase FROM v_scan_phases ORDER BY CASE state WHEN 'running' THEN 0 ELSE 1 END, ord",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Public endpoints",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "exposure-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "exposure-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT endpoints AS \"Endpoints\" FROM v_run_deltas ORDER BY run_id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Change vs last run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
