# Copy to .env. Everything here is passed to the scanner container, so any
# variable can be referenced from config.yaml as ${NAME}.

# --- Database (URL-safe characters only, it goes into a connection URL)
POSTGRES_PASSWORD=change-me
# Read-only role Grafana uses to query results
GRAFANA_DB_PASSWORD=change-me-too

# --- Grafana
# Login for http://localhost:3000 (user: admin)
GF_SECURITY_ADMIN_PASSWORD=change-me-as-well
# Incoming webhook for alerts; https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Scanner
SCAN_INTERVAL_HOURS=24
# A run taking longer is aborted and recorded as failed
RUN_TIMEOUT_HOURS=6
# How often a progress line is logged during a run
PROGRESS_LOG_SECONDS=30
# Run id that progress is measured against; empty = first successful run
BASELINE_RUN_ID=

# --- Referenced from config.yaml
GCP_ORGANIZATION_ID=123456789012
# Service account key JSON on a single line, in single quotes: jq -c . key.json
GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account", ...}'
NVD_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
